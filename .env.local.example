# Copy this file to .env.local and fill in your real keys.

# Gemini (free key, no credit card): https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_key_here

# Google Maps — needs a Google Cloud project with billing enabled and
# Maps JavaScript API, Map Tiles API, and Geocoding API turned on.
# Use two separate keys, restricted differently (see chat setup steps):
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_browser_restricted_key_here
GOOGLE_MAPS_API_KEY=your_server_restricted_key_here

# Spotify (Client Credentials flow)
SPOTIFY_CLIENT_ID=your_spotify_client_id
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret

# Supabase (chat history persistence)
SUPABASE_URL=your_supabase_project_url
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

